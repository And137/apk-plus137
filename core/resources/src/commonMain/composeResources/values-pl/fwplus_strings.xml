    <string name="fwplus_about_title">Czym jest Mesh+ 137?</string>
    <string name="fwplus_about_description">Mesh+ 137 to zmodyfikowana aplikacja Meshtastic-Android dla routerowego firmware FW+ (firmware-plus137). Działa z każdym nodem Meshtastic® i dodaje funkcje FW+: status noda, statystyki na żądanie, ustawienia modułów FW+ i sniffer.</string>
    <string name="fwplus_about_source">Kod źródłowy (Mesh+ 137)</string>
    <string name="fwplus_about_releases">Wydania i aktualizacje</string>
